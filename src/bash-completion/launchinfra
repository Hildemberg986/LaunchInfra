#!/bin/bash
# Bash completion for launchinfra

_launchinfra_completion() {
    local cur prev cword
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"
    cword=$COMP_CWORD

    local commands="--version --help -h help setup-nginx config --list ls --list-ports ports --info --edit --backup backup --remove rm --disable --restore --enable --renew --check-ssl --check-port --check-domain mod --preset --no-ssl --domain --template --max-body --dry-run --force"

    # Função para pegar projetos usando mapfile
    get_projects() {
        local projects=()
        # Usar mapfile para ler a saída do comando com segurança
        mapfile -t projects < <(/usr/bin/launchinfra --list 2>/dev/null | grep -oE '[✓○] [a-zA-Z0-9_-]+' | awk '{print $2}')
        printf '%s ' "${projects[@]}"
    }

    # Tratamento específico para o comando mod (launchinfra mod <projeto> <list|add|rm> [recurso])
    if [ "${COMP_WORDS[1]}" = "mod" ]; then
        case "$cword" in
        2)
            mapfile -t COMPREPLY < <(compgen -W "$(get_projects)" -- "$cur")
            return 0
            ;;
        3)
            mapfile -t COMPREPLY < <(compgen -W "list add rm" -- "$cur")
            return 0
            ;;
        4)
            if [ "${COMP_WORDS[3]}" = "add" ] || [ "${COMP_WORDS[3]}" = "rm" ]; then
                local modifiers="cors security protect-hidden gzip static-cache spa"
                mapfile -t COMPREPLY < <(compgen -W "$modifiers" -- "$cur")
                return 0
            fi
            ;;
        esac
    fi

    case "$prev" in
    help | --help | -h)
        mapfile -t COMPREPLY < <(compgen -W "mod config" -- "$cur")
        ;;
    --info | --edit | --remove | rm | --disable | --restore | --enable | --renew | --backup | backup)
        mapfile -t COMPREPLY < <(compgen -W "$(get_projects)" -- "$cur")
        ;;
    --preset)
        mapfile -t COMPREPLY < <(compgen -W "spa api secure static-cached" -- "$cur")
        ;;
    --domain)
        mapfile -t COMPREPLY < <(compgen -W "exemplo.com" -- "$cur")
        ;;
    --template)
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        ;;
    --email)
        mapfile -t COMPREPLY < <(compgen -W "admin@exemplo.com" -- "$cur")
        ;;
    --check-port)
        mapfile -t COMPREPLY < <(compgen -W "80 443 3000 5000 8000 8080 8443" -- "$cur")
        ;;
    config)
        mapfile -t COMPREPLY < <(compgen -W "--email --domain --show --help" -- "$cur")
        ;;
    *)
        if [[ "$cur" == -* ]]; then
            mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$cur")
        else
            if [ "$cword" -eq 1 ]; then
                mapfile -t COMPREPLY < <(compgen -W "$commands $(get_projects)" -- "$cur")
            fi
        fi
        ;;
    esac
}

complete -o default -F _launchinfra_completion launchinfra
