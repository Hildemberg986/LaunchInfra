#!/bin/bash
set -e

# Detecta qual gerenciador de servicos usar (systemd ou sysvinit)
detect_service_manager() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        echo "systemd"
    elif command -v service >/dev/null 2>&1; then
        echo "sysvinit"
    else
        echo "direct"
    fi
}

reload_nginx() {
    local svc_manager
    svc_manager=$(detect_service_manager)
    case "$svc_manager" in
        systemd)
            /bin/systemctl reload nginx 2>/dev/null || /bin/systemctl restart nginx 2>/dev/null
            ;;
        sysvinit)
            /usr/sbin/service nginx reload 2>/dev/null || /usr/sbin/service nginx restart 2>/dev/null
            ;;
        direct)
            # Fallback direto
            /usr/sbin/nginx -s reload 2>/dev/null || /etc/init.d/nginx restart 2>/dev/null
            ;;
    esac
}

case "$1" in
configure)
    echo "Configurando LaunchInfra..."

    # Compatibilidade: criar grupo de forma segura
    if ! getent group launchinfra >/dev/null 2>&1; then
        groupadd launchinfra 2>/dev/null || echo "Aviso: Nao foi possivel criar grupo launchinfra"
    fi

    mkdir -p /var/www/projetos
    chown root:launchinfra /var/www/projetos
    chmod 2775 /var/www/projetos 2>/dev/null || chmod 775 /var/www/projetos

    touch /var/log/launchinfra.log
    chown root:launchinfra /var/log/launchinfra.log
    chmod 664 /var/log/launchinfra.log 2>/dev/null || chmod 644 /var/log/launchinfra.log

    mkdir -p /etc/launchinfra

    cat >/usr/local/bin/launchinfra-helper <<'HELPER'
#!/bin/bash
# Compatibilidade: detectar gerenciador de servicos
detect_service_manager() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        echo "systemd"
    elif command -v service >/dev/null 2>&1; then
        echo "sysvinit"
    else
        echo "direct"
    fi
}

reload_nginx_service() {
    local svc_manager
    svc_manager=$(detect_service_manager)
    case "$svc_manager" in
        systemd)
            /bin/systemctl reload nginx 2>/dev/null || /bin/systemctl restart nginx 2>/dev/null
            ;;
        sysvinit)
            /usr/sbin/service nginx reload 2>/dev/null || /usr/sbin/service nginx restart 2>/dev/null
            ;;
        direct)
            /usr/sbin/nginx -s reload 2>/dev/null || /etc/init.d/nginx restart 2>/dev/null
            ;;
    esac
}

# Validacoes de seguranca para operacoes privilegiadas
check_safe_path() {
    local target="$1"
    if [ -z "$target" ] || [[ "$target" =~ \.\. ]] || [[ "$target" != /* ]]; then
        echo "Acesso negado: caminho invalido ou com traversal ($target)" >&2
        exit 1
    fi
}

check_nginx_path() {
    local target="$1"
    check_safe_path "$target"
    case "$target" in
        /etc/nginx/sites-available/*|/etc/nginx/sites-enabled/*) ;;
        *)
            echo "Acesso negado: caminho fora da configuracao do Nginx ($target)" >&2
            exit 1
            ;;
    esac
}

check_www_path() {
    local target="$1"
    check_safe_path "$target"
    case "$target" in
        /var/www/projetos/*|/var/www/letsencrypt|/var/www/letsencrypt/*) ;;
        *)
            echo "Acesso negado: caminho fora do diretorio web permitido ($target)" >&2
            exit 1
            ;;
    esac
}

case "$1" in
    nginx-test) /usr/sbin/nginx -t ;;
    nginx-reload) reload_nginx_service ;;
    certbot) shift; /usr/bin/certbot "$@" ;;
    chown-www)
        shift
        check_www_path "$2"
        /bin/chown -R "$1:www-data" "$2" 2>/dev/null || /bin/chown -R "$1:nogroup" "$2"
        /bin/chmod -R 755 "$2"
        ;;
    mkdir)
        shift
        check_www_path "$2"
        /bin/mkdir -p "$2"
        /bin/chown "$1:www-data" "$2" 2>/dev/null || /bin/chown "$1:nogroup" "$2"
        /bin/chmod 755 "$2"
        ;;
    rm-nginx)
        shift
        for p in "$@"; do
            check_nginx_path "$p"
            /bin/rm -f "$p"
        done
        ;;
    rm-files)
        shift
        for p in "$@"; do
            check_www_path "$p"
            if [ "$p" = "/var/www/projetos" ] || [ "$p" = "/var/www/projetos/" ]; then
                echo "Acesso negado: proibido remover diretorio raiz de projetos" >&2
                exit 1
            fi
            /bin/rm -rf "$p"
        done
        ;;
    ln-nginx)
        shift
        check_nginx_path "$1"
        check_nginx_path "$2"
        /bin/ln -sf "$1" "$2"
        ;;
    tee-nginx)
        shift
        for p in "$@"; do
            check_safe_path "$p"
            case "$p" in
                /etc/nginx/sites-available/*|/etc/nginx/sites-enabled/*|/var/www/projetos/*) ;;
                *)
                    echo "Acesso negado: caminho nao permitido para tee-nginx ($p)" >&2
                    exit 1
                    ;;
            esac
        done
        /usr/bin/tee "$@" >/dev/null
        ;;
    tee-log)
        shift
        if [ "$1" != "/var/log/launchinfra.log" ]; then
            echo "Acesso negado: arquivo de log invalido ($1)" >&2
            exit 1
        fi
        /usr/bin/tee -a "$1" >/dev/null
        ;;
    cp-template)
        shift
        check_safe_path "$1"
        check_www_path "$2"
        /bin/cp -r "$1"/* "$2"/
        ;;
    cat-nginx)
        shift
        check_nginx_path "$1"
        /bin/cat "$1"
        ;;
    cp-backup)
        shift
        check_safe_path "$1"
        check_nginx_path "$2"
        /bin/cp "$1" "$2"
        ;;
    openssl-check)
        shift
        target="$1"
        if [ -f "$target" ]; then
            /usr/bin/openssl x509 -noout -enddate -in "$target" 2>/dev/null
        elif [ -f "/etc/letsencrypt/live/$target/cert.pem" ]; then
            /usr/bin/openssl x509 -noout -enddate -in "/etc/letsencrypt/live/$target/cert.pem" 2>/dev/null
        elif [ -f "/etc/letsencrypt/live/$target/fullchain.pem" ]; then
            /usr/bin/openssl x509 -noout -enddate -in "/etc/letsencrypt/live/$target/fullchain.pem" 2>/dev/null
        else
            echo | /usr/bin/timeout 3 /usr/bin/openssl s_client -servername "$target" -connect "$target:443" 2>/dev/null | /usr/bin/openssl x509 -noout -enddate 2>/dev/null || true
        fi
        ;;
    tar-backup)
        shift
    tar-backup)
        shift
        local archive="$1" user="$2" web_dir="$3" nginx_conf="$4"
        check_safe_path "$archive"
        local tar_args=()
        if [ -n "$web_dir" ] && [ -d "$web_dir" ]; then
            check_www_path "$web_dir"
            tar_args+=("-C" "$(dirname "$web_dir")" "$(basename "$web_dir")")
        fi
        if [ -n "$nginx_conf" ] && [ -f "$nginx_conf" ]; then
            check_nginx_path "$nginx_conf"
            tar_args+=("-C" "$(dirname "$nginx_conf")" "$(basename "$nginx_conf")")
        fi

        if [ ${#tar_args[@]} -gt 0 ]; then
            /bin/tar czf "$archive" "${tar_args[@]}"
            /bin/chown "$user:$user" "$archive" 2>/dev/null || true
        elif [ -n "$3" ] && [ -d "$2/$3" ]; then
            check_www_path "$2"
            /bin/tar czf "$archive" -C "$2" "$3"
            /bin/chown "$4:$4" "$archive" 2>/dev/null || true
        else
            echo "Nenhum arquivo para backup" >&2
            exit 1
        fi
        ;;
        ;;
    ss-ports) ss -tulnp 2>/dev/null ;;
    *) echo "Comando invalido: $1"; exit 1 ;;
esac
HELPER
    chmod 755 /usr/local/bin/launchinfra-helper

    echo "%launchinfra ALL=(root) NOPASSWD: /usr/local/bin/launchinfra-helper *" >/etc/sudoers.d/launchinfra
    chmod 440 /etc/sudoers.d/launchinfra

    # Instalar bash completion
    mkdir -p /usr/share/bash-completion/completions
    cat >/usr/share/bash-completion/completions/launchinfra <<'COMPLETION'
_launchinfra_completion() {
    local cur prev words cword
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words=("${COMP_WORDS[@]}")
    cword=$COMP_CWORD

    local commands="--version --help setup-nginx config --list --list-ports --info --edit --remove --disable --restore --renew --check-ssl --check-port --check-domain"

    case "$prev" in
        --info|--edit|--remove|--disable|--restore|--renew)
            # Completar com nomes de projetos
            local projects=$(/usr/bin/launchinfra --list 2>/dev/null | grep -oE '[✓○] [a-zA-Z0-9_-]+' | awk '{print $2}')
            COMPREPLY=($(compgen -W "$projects" -- "$cur"))
            ;;
        --domain)
            # Sugestão genérica
            COMPREPLY=($(compgen -W "exemplo.com" -- "$cur"))
            ;;
        --template)
            # Completar com diretórios
            COMPREPLY=($(compgen -d -- "$cur"))
            ;;
        --email)
            # Completar com padrão de email
            COMPREPLY=($(compgen -W "admin@exemplo.com" -- "$cur"))
            ;;
        --check-port)
            # Portas comuns
            COMPREPLY=($(compgen -W "80 443 3000 5000 8000 8080 8443" -- "$cur"))
            ;;
        config)
            COMPREPLY=($(compgen -W "--email --domain --show --help" -- "$cur"))
            ;;
        *)
            # Completar com comandos principais
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "$commands" -- "$cur"))
            else
                # Completar com nome de projeto se em primeiro argumento
                if [ $cword -eq 1 ]; then
                    local projects=$(/usr/bin/launchinfra --list 2>/dev/null | grep -oE '[✓○] [a-zA-Z0-9_-]+' | awk '{print $2}')
                    COMPREPLY=($(compgen -W "$commands $projects" -- "$cur"))
                fi
            fi
            ;;
    esac
}

complete -o default -F _launchinfra_completion launchinfra
COMPLETION
    chmod 644 /usr/share/bash-completion/completions/launchinfra

    echo "LaunchInfra configurado."
    echo ""
    echo "Para adicionar usuarios:"
    echo "  sudo usermod -aG launchinfra NOME"
    echo "  (faca logout/login para aplicar)"
    ;;
esac
exit 0
